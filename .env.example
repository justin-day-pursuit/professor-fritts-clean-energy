# Copy this file to .env and fill in real values. Never commit .env.

# LLM key from the instructor (the agent's model)
ANTHROPIC_API_KEY=

# NLR (formerly NREL) key: PVWatts and REopt. Free at developer.nlr.gov
NLR_API_KEY=

# OpenEI utility rates. Free key
OPENEI_API_KEY=

# EIA Open Data v2. Free key
EIA_API_KEY=

# NYC Open Data / data.ny.gov (SODA) app token. Optional, avoids rate limits
SODA_APP_TOKEN=

# DSIRE (check whether API access is available)
DSIRE_API_KEY=
