# Copy to .env at the project root and fill in values. Never commit .env.

# Claude — Anthropic API for the planning agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Agent harness — how the agent runs tools and limits work per session
LLM_PROVIDER=anthropic
TOOL_MODE=mock
TOOL_CALL_LIMIT=40
TOOL_RETRY_LIMIT=2
RUN_TIMEOUT_SECONDS=600

# Backend — Django/FastAPI server bind and security (dev defaults)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for local SQLite (backend/.data/dev.sqlite3).
# Supabase: session pooler, port 5432. Do not use the transaction pooler (port 6543).
# Copy host, port, and username from the dashboard Connect panel. Percent-encode
# reserved characters in the password (&, #, ?, space). Never commit the real URL.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
DATABASE_URL=

# Frontend — URL the browser uses to call the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase later — database/auth when wired up
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live data keys later — external energy and open-data APIs
NLR_API_KEY=
OPENEI_API_KEY=
EIA_API_KEY=
SODA_APP_TOKEN=
